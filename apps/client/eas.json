{
  "cli": {
    "version": ">=18.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-twelvedaily.doze.dev.br"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-twelvedaily.doze.dev.br"
      }
    }
  }
}
