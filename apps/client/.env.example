# Variáveis públicas do cliente Expo (prefixo EXPO_PUBLIC_ → embutidas no bundle).
# Copie para `.env` e ajuste conforme ONDE você roda o app. Reinicie com
# `expo start --clear` após alterar (o valor é inlinado no bundle).

# URL da API consumida pelo cliente:
# - Web / simulador iOS:   http://localhost:5000   (default se não definir)
# - Emulador Android:      http://10.0.2.2:5000     (10.0.2.2 = host visto pelo emulador)
# - Celular físico:        http://<IP-da-sua-maquina-na-LAN>:5000
#
# Em PRODUÇÃO este valor NÃO vem daqui: é injetado como --build-arg da imagem Web
# (ex.: https://api-twelvedaily.doze.dev.br). Ver apps/client/Dockerfile.
EXPO_PUBLIC_API_URL=http://localhost:5000
